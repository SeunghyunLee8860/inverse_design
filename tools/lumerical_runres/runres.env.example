# Required target-site settings. Do not run a reservation before verifying them.
export MSOPT_RESERVE_OPT_FILE=/path/on/license/server/ansyslmd.opt
export MSOPT_RESERVE_LOCK_FILE=/path/on/license/server/.runres.lock
export MSOPT_RESERVE_LMUTIL=/opt/lumerical/v261/licensingclient/linx64/lmutil
export MSOPT_RESERVE_SERVER=1055@license-server-hostname
export MSOPT_RESERVE_FEATURE=lum_fdtd_solve
export MSOPT_RESERVE_COUNT=9

# Use /usr/bin/env when the target site has no msopt `run` wrapper.
export MSOPT_RUN_CMD=/usr/bin/env

# Optional tuning.
export MSOPT_RESERVE_WAIT_POLL_S=15
export MSOPT_RESERVE_VERIFY_TIMEOUT_S=45
export MSOPT_RESERVE_VERIFY_POLL_S=2
export MSOPT_RESERVE_ALLOW_SUDO=0
