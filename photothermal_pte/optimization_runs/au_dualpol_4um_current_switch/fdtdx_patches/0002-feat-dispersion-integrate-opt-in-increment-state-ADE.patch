+"""End-to-end gates for the opt-in increment-state dispersive FDTD path."""
+
+import jax
+import jax.numpy as jnp
+import pytest
+
+import fdtdx
+from fdtdx.config import SimulationConfig
+from fdtdx.core.grid import UniformGrid
+from fdtdx.fdtd.fdtd import checkpointed_fdtd
+from fdtdx.increment_state import compute_increment_state_coefficients_per_axis
+from fdtdx.objects.static_material.static import UniformMaterialObject
+from tests.simulation.fdtd.test_time_reversal import (
+    _build_lossy_dispersive_scene,
+    _coef_fd_check,
+    _make_disp_loss_fn,
+    _passive_ccpr_pole,
+)
+
+
+def test_increment_coefficients_are_placed_as_a_c_b():
+    """The full placement path stores A/C/B, not rounded c1/c2/c3."""
+    objects, arrays, config = _build_lossy_dispersive_scene(state_representation="increment")
+    slab = next(o for o in objects.objects if isinstance(o, UniformMaterialObject) and o.name == "slab")
+    assert slab.material.dispersion is not None
+    coeff_a, coeff_c, coeff_b = compute_increment_state_coefficients_per_axis(
+        slab.material.dispersion.poles, config.time_step_duration
+    )
+
+    xs, ys, zs = slab.grid_slice
+    assert arrays.dispersive_c1 is not None
+    assert arrays.dispersive_c2 is not None
+    assert arrays.dispersive_c3 is not None
+    assert arrays.dispersive_c4 is None
+    assert jnp.allclose(arrays.dispersive_c1[0, 0, xs, ys, zs], coeff_a[0, 0])
+    assert jnp.allclose(arrays.dispersive_c2[0, 0, xs, ys, zs], coeff_c[0, 0])
+    assert jnp.allclose(arrays.dispersive_c3[0, 0, xs, ys, zs], coeff_b[0, 0])
+
+
+def test_checkpointed_increment_b_gradient_matches_finite_difference():
+    """Differentiate a real driven dispersive FDTD run through B and compare FD."""
+    objects, arrays, config = _build_lossy_dispersive_scene(state_representation="increment")
+    coeff_b = arrays.dispersive_c3
+    assert coeff_b is not None
+    loss_fn = _make_disp_loss_fn("c3")
+    ad, fd, rel_err, diff, idx = _coef_fd_check(
+        coeff_b,
+        loss_fn,
+        arrays,
+        objects,
+        config,
+        jax.random.PRNGKey(99),
+        h_scale=1e-2,
+        h_floor=1e-6,
+        fdtd_impl=checkpointed_fdtd,
+    )
+    assert jnp.isfinite(ad) and jnp.isfinite(fd)
+    assert rel_err < 0.1 or diff < 1e-5, (
+        f"increment B AD vs FD mismatch at {idx}: AD={float(ad):.6e}, FD={float(fd):.6e}, rel_err={rel_err:.3e}"
+    )
+
+
+def test_increment_ccpr_is_rejected_during_full_placement():
+    config = SimulationConfig(
+        time=1.0e-14,
+        grid=UniformGrid(spacing=1.0e-7),
+        backend="cpu",
+        dispersive_state_representation="increment",
+    )
+    volume = fdtdx.SimulationVolume(partial_grid_shape=(8, 8, 8))
+    material = fdtdx.Material(
+        permittivity=2.0,
+        dispersion=fdtdx.DispersionModel(poles=(_passive_ccpr_pole(),)),
+    )
+    slab = fdtdx.UniformMaterialObject(
+        name="ccpr",
+        partial_grid_shape=(4, 4, 4),
+        material=material,
+    )
+    constraint = slab.set_grid_coordinates(axes=(0, 1, 2), sides=("-", "-", "-"), coordinates=(2, 2, 2))
+    with pytest.raises(NotImplementedError, match="Lorentz/Drude"):
+        fdtdx.place_objects(
+            object_list=[volume, slab],
+            config=config,
+            constraints=[constraint],
+            key=jax.random.PRNGKey(0),
+        )
