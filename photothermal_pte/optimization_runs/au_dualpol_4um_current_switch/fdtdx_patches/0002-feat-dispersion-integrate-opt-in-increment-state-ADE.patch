diff --git a/src/fdtdx/config.py b/src/fdtdx/config.py
index 593e3d0..dbe4326 100644
--- a/src/fdtdx/config.py
+++ b/src/fdtdx/config.py
@@ -86,6 +86,13 @@ class SimulationConfig(TreeClass):
     #: False: force real fields (raises error if Bloch boundaries are present).
     use_complex_fields: bool | None = frozen_field(default=None)
 
+    #: Representation used for Lorentz/Drude auxiliary polarization states.
+    #: ``"polarization"`` preserves the classic second-order recurrence.
+    #: ``"increment"`` stores ``(P, delta-P)`` and cancellation-resistant
+    #: ``(A, C, B)`` coefficients; it currently supports only axis-aligned
+    #: Lorentz/Drude poles with diagonal material tensors.
+    dispersive_state_representation: Literal["polarization", "increment"] = frozen_field(default="polarization")
+
     #: Safety factor for the Courant condition (default: 0.99).
     courant_factor: float = frozen_field(default=0.99)
 
@@ -117,6 +124,12 @@ class SimulationConfig(TreeClass):
     def __post_init__(self):
         from jax import extend
 
+        if self.dispersive_state_representation not in ("polarization", "increment"):
+            raise ValueError(
+                "dispersive_state_representation must be 'polarization' or "
+                f"'increment', got {self.dispersive_state_representation!r}"
+            )
+
         if len(self.symmetry) != 3 or any(s not in (-1, 0, 1) for s in self.symmetry):
             raise ValueError(
                 f"config.symmetry must be a length-3 tuple with each entry in {{-1, 0, +1}} "
diff --git a/src/fdtdx/dispersion.py b/src/fdtdx/dispersion.py
index 921118c..1b5997f 100644
--- a/src/fdtdx/dispersion.py
+++ b/src/fdtdx/dispersion.py
@@ -1073,6 +1073,7 @@ def compute_eps_spectrum_from_coefficients(
     dt: float,
     weights: np.ndarray | None = None,
     c4: jax.Array | np.ndarray | None = None,
+    state_representation: str = "polarization",
 ) -> np.ndarray:
     """Spatially-averaged complex permittivity spectrum for a block of cells.
 
@@ -1104,11 +1105,19 @@ def compute_eps_spectrum_from_coefficients(
         dt: Simulation time step (seconds) used to derive the coefficients.
         weights: Optional spatial weights with the same shape as the
             trailing axes of ``c1``. If ``None``, uniform averaging.
+        c4: Optional classic CCPR dE/dt coefficient. Unsupported in increment mode.
+        state_representation: Stored coefficient meaning, ``"polarization"``
+            (classic) or ``"increment"`` (A/C/B).
 
     Returns:
         Complex numpy array of shape ``(len(omegas),)`` — the volume-averaged
         :math:`\\varepsilon(\\omega)` at each requested frequency.
     """
+    if state_representation not in ("polarization", "increment"):
+        raise ValueError(f"state_representation must be 'polarization' or 'increment', got {state_representation!r}")
+    if state_representation == "increment" and c4 is not None:
+        raise ValueError("increment-state spectrum does not support c4 dE/dt coupling.")
+
     c1_np = np.asarray(c1)
     c2_np = np.asarray(c2)
     c3_np = np.asarray(c3)
@@ -1154,6 +1163,20 @@ def compute_eps_spectrum_from_coefficients(
     safe_denom = np.where(pole_mask[None, ...], denom, 1.0 + 0.0j)
     chi_per_pole = np.where(pole_mask[None, ...], numer / safe_denom, 0.0 + 0.0j)
     chi_per_cell = chi_per_pole.sum(axis=1)  # sum over pole axis → (M, C, *spatial)
+    if state_representation == "increment":
+        # Direct discrete transfer function for A/C/B. Do not reconstruct the
+        # nearly cancelling second-order coefficients in setup precision.
+        increment_mask = (c1_np != 0.0) | (c2_np != 0.0) | (c3_np != 0.0)
+        z_minus = np.exp(-1j * omega_dt)
+        increment_denom = (z_minus - 1.0) * (z_minus - c1_np[None, ...])
+        increment_denom = increment_denom + c2_np[None, ...] * z_minus
+        safe_increment_denom = np.where(increment_mask[None, ...], increment_denom, 1.0 + 0.0j)
+        increment_chi = np.where(
+            increment_mask[None, ...],
+            c3_np[None, ...] * z_minus / safe_increment_denom,
+            0.0 + 0.0j,
+        )
+        chi_per_cell = increment_chi.sum(axis=1)
     # Average the material-component axis (identity for C = 1), mirroring the
     # eps_inf reduction above — this scalar spectrum feeds an impedance filter
     # that has no notion of polarization. For a 9-component coupling only the
@@ -1251,6 +1274,27 @@ def compute_impedance_corrected_temporal_profile(
     return filtered[:n].astype(np.float64)
 
 
+def _susceptibility_from_state_coefficients(
+    c1: jax.Array,
+    c2: jax.Array,
+    c3: jax.Array,
+    omega: float,
+    dt: float,
+    c4: jax.Array | None,
+    state_representation: str,
+) -> jax.Array:
+    """Dispatch discrete susceptibility according to the stored ADE state."""
+    if state_representation == "increment":
+        if c4 is not None:
+            raise ValueError("increment-state susceptibility does not support c4 dE/dt coupling.")
+        from fdtdx.increment_state import susceptibility_from_increment_coefficients
+
+        return susceptibility_from_increment_coefficients(c1, c2, c3, omega=omega, dt=dt)
+    if state_representation != "polarization":
+        raise ValueError(f"state_representation must be 'polarization' or 'increment', got {state_representation!r}")
+    return susceptibility_from_coefficients(c1=c1, c2=c2, c3=c3, omega=omega, dt=dt, c4=c4)
+
+
 def effective_inv_permittivity(
     inv_eps: jax.Array,
     c1: jax.Array | None,
@@ -1259,6 +1303,7 @@ def effective_inv_permittivity(
     omega: float,
     dt: float,
     c4: jax.Array | None = None,
+    state_representation: str = "polarization",
 ) -> jax.Array:
     """Per-cell real inverse permittivity :math:`1/\\text{Re}(\\varepsilon_\\infty + \\chi(\\omega))`.
 
@@ -1279,6 +1324,9 @@ def effective_inv_permittivity(
         c3: ADE coefficient array of shape ``(num_poles, ...)`` or ``None``.
         omega: Angular frequency (rad/s) at which to evaluate.
         dt: Simulation time step (seconds).
+        c4: Optional classic CCPR dE/dt coefficient.
+        state_representation: Stored coefficient meaning, ``"polarization"``
+            (classic) or ``"increment"`` (A/C/B).
 
     Returns:
         Real-valued ``jax.Array`` with the same shape and dtype as
@@ -1293,7 +1341,7 @@ def effective_inv_permittivity(
         # Elementwise 1/inv_eps would divide by the zero off-diagonal entries.
         eps_mat = jnp.real(_eps_matrix_from_inv(inv_eps_arr))
         if c1 is not None and c2 is not None and c3 is not None:
-            chi = susceptibility_from_coefficients(c1=c1, c2=c2, c3=c3, omega=omega, dt=dt, c4=c4)
+            chi = _susceptibility_from_state_coefficients(c1, c2, c3, omega, dt, c4, state_representation)
             eps_mat = eps_mat + jnp.real(_tensor_from_components(chi))
         inv_eff = _invert_3x3_matrix_field(eps_mat)
         return inv_eff.reshape(9, *inv_eff.shape[2:]).astype(inv_eps_arr.dtype)
@@ -1301,7 +1349,7 @@ def effective_inv_permittivity(
     if c1 is None or c2 is None or c3 is None:
         return inv_eps
 
-    chi = susceptibility_from_coefficients(c1=c1, c2=c2, c3=c3, omega=omega, dt=dt, c4=c4)
+    chi = _susceptibility_from_state_coefficients(c1, c2, c3, omega, dt, c4, state_representation)
     eps_inf = 1.0 / inv_eps_arr
     eps_eff = eps_inf + jnp.real(chi)
     return (1.0 / eps_eff).astype(inv_eps_arr.dtype)
@@ -1317,6 +1365,7 @@ def effective_complex_inv_permittivity(
     electric_conductivity: jax.Array | None = None,
     conductivity_spacing: float | None = None,
     c4: jax.Array | None = None,
+    state_representation: str = "polarization",
 ) -> jax.Array:
     r"""Per-cell COMPLEX inverse permittivity :math:`1 / (\varepsilon_\infty + \chi(\omega) + i\sigma/(\varepsilon_0\omega))`.
 
@@ -1349,6 +1398,9 @@ def effective_complex_inv_permittivity(
         electric_conductivity: Resolution-scaled conductivity array, or ``None``.
         conductivity_spacing: Scaling factor used to recover the physical
             conductivity. Required when ``electric_conductivity`` is given.
+        c4: Optional classic CCPR dE/dt coefficient.
+        state_representation: Stored coefficient meaning, ``"polarization"``
+            (classic) or ``"increment"`` (A/C/B).
 
     Returns:
         Complex ``jax.Array`` broadcasting ``inv_eps`` against the loss terms.
@@ -1363,7 +1415,7 @@ def effective_complex_inv_permittivity(
         eps_mat = _eps_matrix_from_inv(inv_eps)
         eps = jnp.stack([eps_mat[0, 0], eps_mat[1, 1], eps_mat[2, 2]], axis=0).astype(complex_dtype)
         if c1 is not None and c2 is not None and c3 is not None:
-            chi = susceptibility_from_coefficients(c1=c1, c2=c2, c3=c3, omega=omega, dt=dt, c4=c4)
+            chi = _susceptibility_from_state_coefficients(c1, c2, c3, omega, dt, c4, state_representation)
             if chi.shape[0] == 9:
                 chi = jnp.stack([chi[0], chi[4], chi[8]], axis=0)
             eps = eps + chi
@@ -1378,7 +1430,7 @@ def effective_complex_inv_permittivity(
 
     eps = (1.0 / inv_eps).astype(complex_dtype)
     if c1 is not None and c2 is not None and c3 is not None:
-        eps = eps + susceptibility_from_coefficients(c1=c1, c2=c2, c3=c3, omega=omega, dt=dt, c4=c4)
+        eps = eps + _susceptibility_from_state_coefficients(c1, c2, c3, omega, dt, c4, state_representation)
     if electric_conductivity is not None:
         if conductivity_spacing is None:
             raise ValueError("conductivity_spacing is required when electric_conductivity is given.")
