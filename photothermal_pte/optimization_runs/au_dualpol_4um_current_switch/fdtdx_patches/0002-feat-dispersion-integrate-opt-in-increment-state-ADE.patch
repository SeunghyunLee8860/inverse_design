@@ -0,0 +1,63 @@
+"""Spectrum and configuration gates for opt-in increment-state ADE."""
+
+import numpy as np
+import pytest
+
+from fdtdx.config import SimulationConfig
+from fdtdx.core.grid import UniformGrid
+from fdtdx.dispersion import LorentzPole, compute_eps_spectrum_from_coefficients
+from fdtdx.increment_state import compute_increment_state_coefficients_per_axis
+
+
+def test_increment_epsilon_spectrum_uses_direct_discrete_transfer_function():
+    pole = LorentzPole(
+        resonance_frequency=2.0e14,
+        damping=1.5e13,
+        delta_epsilon=2.25,
+    )
+    dt = 1.0e-16
+    coeff_a, coeff_c, coeff_b = compute_increment_state_coefficients_per_axis((pole,), dt)
+    # Isotropic coefficient tier with one spatial cell.
+    a = coeff_a[:, :1, None, None, None]
+    c = coeff_c[:, :1, None, None, None]
+    b = coeff_b[:, :1, None, None, None]
+    omegas = np.asarray([0.55e14, 1.4e14, 2.6e14])
+
+    actual = compute_eps_spectrum_from_coefficients(
+        c1=a,
+        c2=c,
+        c3=b,
+        inv_eps_inf=np.full((1, 1, 1, 1), 0.5),
+        omegas=omegas,
+        dt=dt,
+        state_representation="increment",
+    )
+    z_minus = np.exp(-1j * omegas[:, None, None, None, None, None] * dt)
+    denominator = (z_minus - 1.0) * (z_minus - a[None, ...]) + c[None, ...] * z_minus
+    expected = 2.0 + (b[None, ...] * z_minus / denominator).sum(axis=(1, 2, 3, 4, 5))
+    np.testing.assert_allclose(actual, expected, rtol=2e-13, atol=2e-13)
+
+
+def test_increment_spectrum_rejects_c4():
+    zeros = np.zeros((1, 1, 1, 1, 1))
+    with pytest.raises(ValueError, match="c4"):
+        compute_eps_spectrum_from_coefficients(
+            c1=zeros,
+            c2=zeros,
+            c3=zeros,
+            c4=zeros,
+            inv_eps_inf=np.ones((1, 1, 1, 1)),
+            omegas=np.asarray([1.0]),
+            dt=1.0,
+            state_representation="increment",
+        )
+
+
+def test_invalid_dispersive_state_representation_is_rejected():
+    with pytest.raises(ValueError, match="dispersive_state_representation"):
+        SimulationConfig(
+            time=1.0e-15,
+            grid=UniformGrid(spacing=1.0e-7),
+            backend="cpu",
+            dispersive_state_representation="unknown",  # type: ignore[arg-type]
+        )
