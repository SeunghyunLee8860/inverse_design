+def test_checkpointed_increment_drude_b_gradient_matches_finite_difference():
+    """Exercise the Drude C=0 branch through a full checkpointed FDTD AD-FD."""
+    material = fdtdx.Material(
+        permittivity=1.0,
+        dispersion=fdtdx.DispersionModel(
+            poles=(fdtdx.DrudePole(plasma_frequency=1.0e15, damping=2.0e14),),
+        ),
+    )
+    with _x64_enabled():
+        objects, arrays, config = _build_lossy_dispersive_scene(
+            state_representation="increment", material=material, dtype=jnp.float64
+        )
+        coeff_b = arrays.dispersive_c3
+        assert coeff_b is not None
+        ad, fd, rel_err, diff, idx = _coef_fd_check(
+            coeff_b,
+            _make_disp_loss_fn("c3"),
+            arrays,
+            objects,
+            config,
+            jax.random.PRNGKey(99),
+            h_scale=1e-4,
+            h_floor=1e-10,
+            fdtd_impl=checkpointed_fdtd,
+        )
+        assert jnp.isfinite(ad) and jnp.isfinite(fd)
+        assert rel_err < 1e-4 or diff < 1e-9, (
+            f"increment Drude B AD vs FD mismatch at {idx}: AD={float(ad):.6e}, "
+            f"FD={float(fd):.6e}, rel_err={rel_err:.3e}"
+        )
