+def assert_source_range(values, label):
+    expected = {
+        "wavelength start": SOURCE_WL_START,
+        "wavelength stop": SOURCE_WL_STOP,
+        "minimum wavelength": SOURCE_WL_START,
+        "maximum wavelength": SOURCE_WL_STOP,
+    }
+    for key, value in values.items():
+        if key in expected and not np.isclose(
+            value, expected[key], rtol=1e-10, atol=1e-15
+        ):
+            raise RuntimeError(
+                f"{label}.{key}={value:.9e}, expected {expected[key]:.9e}"
+            )
